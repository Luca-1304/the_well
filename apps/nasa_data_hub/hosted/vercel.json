{
  "rewrites": [
    { "source": "/api/health", "destination": "/api/nasa?mode=health" },
    { "source": "/api/apod", "destination": "/api/nasa?mode=apod" },
    { "source": "/api/neo", "destination": "/api/nasa?mode=neo" },
    { "source": "/api/donki", "destination": "/api/nasa?mode=donki" },
    { "source": "/api/eonet", "destination": "/api/nasa?mode=eonet" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src https: data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests" }
      ]
    }
  ]
}
